
valor_casa = float(input('Qual o valor da casa?: '))
salário = int(input('Qual é o seu salário?: '))
quantidade_anos = int(input('Quantos anos a pagar?: '))


limite = salário * 0.30

prestação = valor_casa / (quantidade_anos * 12)

if prestação < limite:
    print('Parabéns, você foi aprovado')
else:
    print('Que pena, infezlimente você não foi aprovado')

